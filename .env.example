# ─────────────────────────────────────────────────────────────────────
# Plantilla de variables de entorno.
# Copiá este archivo a `.env.local` y completá los placeholders.
# `.env.local` está en .gitignore — no se sube al repo.
# `.env.example` SÍ se commitea — NUNCA pongas valores reales acá.
# Para producción, cargá las mismas variables en Vercel.
# ─────────────────────────────────────────────────────────────────────

# GitHub: el admin lee y escribe content/restaurants/ via API.
GITHUB_TOKEN=__REPLACE_with_PAT_fine_grained_Contents_RW__
GITHUB_OWNER=xvirs
GITHUB_REPO=menudigital-platform
GITHUB_BRANCH=main

# Basic Auth para /admin/* y /api/admin/*.
ADMIN_USER=admin
ADMIN_PASS=__REPLACE_with_random_28_chars__

# n8n webhook (admin forwardea PDFs acá para que n8n los procese).
# La URL de cloudflared cambia cada vez que reiniciás el tunnel.
N8N_WEBHOOK_URL=__REPLACE_with_cloudflared_tunnel_url__/webhook/new-pdf
N8N_WEBHOOK_SECRET=__REPLACE_with_same_secret_as_n8n_env__
