{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://menudigital-platform.vercel.app/schema/menu.schema.json",
  "title": "Restaurant Menu",
  "description": "Estructura de datos de un restaurante: metadata, info pública, secciones y catálogo de items.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "status",
    "version",
    "createdAt",
    "updatedAt",
    "_meta",
    "info",
    "menuSections",
    "items"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Identificador kebab-case. Debe matchear el nombre del archivo."
    },
    "status": {
      "type": "string",
      "enum": ["active", "hidden"]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },

    "_meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourcePdfName", "extractedBy", "missingFields"],
      "properties": {
        "sourcePdfName": { "type": "string" },
        "extractedBy": { "type": "string" },
        "missingFields": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Paths en dot-notation que el LLM no pudo extraer."
        }
      }
    },

    "info": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "theme"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "location": { "type": "string" },
        "subtitle": { "type": "string" },
        "since": { "type": "string" },
        "description": { "type": "string" },
        "schedule": { "type": "string" },
        "social": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "instagram": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "url": { "type": "string" },
                "handle": { "type": "string" }
              }
            },
            "whatsapp": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "number": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          }
        },
        "theme": {
          "type": "object",
          "additionalProperties": false,
          "required": ["primaryColor", "backgroundColor", "textColor", "accentColor", "fonts"],
          "properties": {
            "primaryColor": { "$ref": "#/$defs/hexColor" },
            "backgroundColor": { "$ref": "#/$defs/hexColor" },
            "textColor": { "$ref": "#/$defs/hexColor" },
            "accentColor": { "$ref": "#/$defs/hexColor" },
            "fonts": {
              "type": "object",
              "additionalProperties": false,
              "required": ["heading", "body"],
              "properties": {
                "heading": { "type": "string", "minLength": 1 },
                "body": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },

    "menuSections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "items"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "title": { "type": "string", "minLength": 1 },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
          }
        }
      }
    },

    "items": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9]+(-[a-z0-9]+)*$": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slug", "name", "price", "icon"],
          "properties": {
            "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
            "name": { "type": "string", "minLength": 1 },
            "price": {
              "type": "string",
              "pattern": "^([0-9]+|_dato no disponible_)$",
              "description": "Solo dígitos sin símbolo, o el sentinela de dato faltante."
            },
            "shortDescription": { "type": "string" },
            "description": { "type": "string" },
            "ingredients": {
              "type": "array",
              "items": { "type": "string" }
            },
            "type": { "type": "string" },
            "icon": { "type": "string", "minLength": 1 }
          }
        }
      },
      "additionalProperties": false
    }
  },

  "$defs": {
    "hexColor": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    }
  }
}
