---
import type { MenuItem, Restaurant } from '../../types/restaurant';
import { isMissing } from '../../types/restaurant';
import { formatPrice } from '../../lib/restaurants';

interface Props {
  item: MenuItem;
  restaurantSlug: Restaurant['slug'];
}

const { item, restaurantSlug } = Astro.props;

const hasDescription = !isMissing(item.description);
const hasIngredients = Array.isArray(item.ingredients) && item.ingredients.length > 0;
const isClickable = hasDescription || hasIngredients;

const shortDesc = !isMissing(item.shortDescription) ? item.shortDescription : undefined;
const priceLabel = isMissing(item.price) ? '—' : formatPrice(item.price);

const searchText = [
  item.name,
  shortDesc,
  item.description,
  ...(item.ingredients ?? []),
  item.type,
]
  .filter((s): s is string => Boolean(s) && !isMissing(s))
  .join(' ')
  .normalize('NFD')
  .replace(/[̀-ͯ]/g, '')
  .toLowerCase();

const href = `/r/${restaurantSlug}/${item.slug}/`;
const Wrapper = isClickable ? 'a' : 'div';
---

<li class="menu-item" data-search={searchText}>
  <Wrapper
    class={isClickable ? 'menu-item__link' : 'menu-item__static'}
    href={isClickable ? href : undefined}
  >
    <div class="menu-item__body">
      <h3 class="menu-item__name">{item.name}</h3>
      {shortDesc && <p class="menu-item__short">{shortDesc}</p>}
    </div>
    <div class="menu-item__price-wrapper">
      <span class="menu-item__price">{priceLabel}</span>
    </div>
  </Wrapper>
</li>
