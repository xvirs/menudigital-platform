---
import type { Restaurant } from '../types/restaurant';
import '../styles/global.css';

interface Props {
  restaurant: Restaurant;
  pageTitle?: string;
  pageDescription?: string;
}

const { restaurant, pageTitle, pageDescription } = Astro.props;
const { info } = restaurant;
const { theme } = info;

const title = pageTitle ?? info.name;
const description = pageDescription ?? info.description ?? `Menú de ${info.name}`;

const extractFontName = (str: string) => {
  if (!str) return null;
  // Match the first font name before a comma, stripping quotes
  const firstFont = str.split(',')[0].trim();
  return firstFont.replace(/['"]/g, '');
};

const headingFontName = extractFontName(theme.fonts.heading);
const bodyFontName = extractFontName(theme.fonts.body);

const fontFamilies = new Set<string>();
if (headingFontName) fontFamilies.add(headingFontName.replace(/ /g, '+'));
if (bodyFontName) fontFamilies.add(bodyFontName.replace(/ /g, '+'));
// Add our premium fallbacks
fontFamilies.add('Inter:wght@300;400;500;600');
fontFamilies.add('Playfair+Display:ital,wght@0,400;0,600;0,700;1,400');

const googleFontsUrl = `https://fonts.googleapis.com/css2?family=${Array.from(fontFamilies).join('&family=')}&display=swap`;
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="restaurant.menu" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={googleFontsUrl} rel="stylesheet" />
    <title>{title}</title>

    <style
      is:global
      define:vars={{
        primaryColor: theme.primaryColor,
        backgroundColor: theme.backgroundColor,
        textColor: theme.textColor,
        accentColor: theme.accentColor,
        fontHeading: theme.fonts.heading,
        fontBody: theme.fonts.body,
      }}
    >
      :root {
        --primary-color: var(--primaryColor);
        --background-color: var(--backgroundColor);
        --text-color: var(--textColor);
        --accent-color: var(--accentColor);
        --font-heading: var(--fontHeading), 'Playfair Display', Georgia, serif;
        --font-body: var(--fontBody), 'Inter', system-ui, -apple-system, sans-serif;
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
