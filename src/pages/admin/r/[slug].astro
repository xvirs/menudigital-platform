---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getRestaurant } from '../../../lib/github';
import '../../../styles/admin.css';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/admin');

let restaurant: Awaited<ReturnType<typeof getRestaurant>> = null;
let loadError: string | null = null;
try {
  restaurant = await getRestaurant(slug);
} catch (err: any) {
  loadError = err?.message ?? 'Error desconocido.';
}

if (!loadError && !restaurant) {
  return new Response('Restaurant not found', { status: 404 });
}

const owner = import.meta.env.GITHUB_OWNER;
const repo = import.meta.env.GITHUB_REPO;
const branch = import.meta.env.GITHUB_BRANCH || 'main';
const editUrl = restaurant
  ? `https://github.com/${owner}/${repo}/edit/${branch}/content/restaurants/${restaurant.slug}.json`
  : '#';
const publicUrl = restaurant ? `/r/${restaurant.slug}/` : '#';
const nextStatus = restaurant?.status === 'active' ? 'hidden' : 'active';
const toggleLabel = restaurant?.status === 'active' ? 'Ocultar' : 'Mostrar';
const toggleIcon = restaurant?.status === 'active' ? '👁' : '👀';

const dateFormatter = new Intl.DateTimeFormat('es-AR', {
  dateStyle: 'medium',
  timeStyle: 'short',
});
const formattedUpdated = restaurant
  ? (() => {
      const d = new Date(restaurant.updatedAt);
      return Number.isNaN(d.getTime()) ? restaurant.updatedAt : dateFormatter.format(d);
    })()
  : '—';
---

<BaseLayout title={`Admin · ${restaurant?.info.name ?? slug}`}>
  <main class="container admin-shell">
    <a class="admin-back" href="/admin">← Volver a la lista</a>

    {loadError ? (
      <div class="admin-banner admin-banner--err" role="alert">
        <span><strong>No se pudo leer el restaurante.</strong> {loadError}</span>
      </div>
    ) : restaurant && (
      <>
        <header class="admin-shell__header">
          <div>
            <h1 class="admin-shell__title">{restaurant.info.name}</h1>
            <p class="admin-shell__sub">
              <code>{restaurant.slug}</code>
              <span class={`admin-status admin-status--${restaurant.status}`} style="margin-left:0.5rem;">
                {restaurant.status}
              </span>
            </p>
          </div>
          <div class="admin-actions">
            <a class="admin-btn" href={publicUrl} target="_blank" rel="noopener">
              <span class="admin-btn__icon" aria-hidden="true">↗</span>
              <span>Ver público</span>
            </a>
            <a class="admin-btn" href={editUrl} target="_blank" rel="noopener">
              <span class="admin-btn__icon" aria-hidden="true">✎</span>
              <span>Editar en GitHub</span>
            </a>
            <form method="POST" action="/api/admin/toggle" data-pending>
              <input type="hidden" name="slug" value={restaurant.slug} />
              <input type="hidden" name="status" value={nextStatus} />
              <button class="admin-btn" type="submit">
                <span class="admin-btn__icon" aria-hidden="true">{toggleIcon}</span>
                <span>{toggleLabel}</span>
              </button>
            </form>
            <form
              method="POST"
              action="/api/admin/delete"
              data-pending
              data-confirm={`¿Eliminar ${restaurant.slug}? El JSON se borra del repo. NO se puede deshacer desde el dashboard.`}
            >
              <input type="hidden" name="slug" value={restaurant.slug} />
              <button class="admin-btn admin-btn--danger" type="submit">
                <span class="admin-btn__icon" aria-hidden="true">🗑</span>
                <span>Eliminar</span>
              </button>
            </form>
          </div>
        </header>

        <div class="admin-grid">
          <section class="admin-panel">
            <h2 class="admin-panel__title">Preview público</h2>
            <div class="admin-preview-frame">
              <iframe class="admin-iframe" src={publicUrl} title={`Preview ${restaurant.info.name}`} loading="lazy"></iframe>
            </div>
          </section>

          <aside style="display: flex; flex-direction: column; gap: 1rem;">
            <section class="admin-panel">
              <h2 class="admin-panel__title">Metadata</h2>
              <dl class="admin-meta">
                <dt>Versión</dt><dd>v{restaurant.version}</dd>
                <dt>Actualizado</dt><dd>{formattedUpdated}</dd>
                <dt>Extraído por</dt><dd>{restaurant._meta.extractedBy}</dd>
                <dt>PDF origen</dt><dd>{restaurant._meta.sourcePdfName}</dd>
                <dt>Secciones</dt><dd>{restaurant.menuSections.length}</dd>
                <dt>Platos</dt><dd>{Object.keys(restaurant.items).length}</dd>
              </dl>
            </section>

            {restaurant._meta.missingFields.length > 0 && (
              <section class="admin-panel">
                <h2 class="admin-panel__title" style="color: var(--danger-color);">⚠ Campos faltantes</h2>
                <p style="font-size: 0.85rem; opacity: 0.7; margin-bottom: 0.75rem;">
                  Estos campos no se pudieron extraer del PDF. Editá el JSON en GitHub para completarlos.
                </p>
                <ul style="display: flex; flex-direction: column; gap: 0.3rem; font-family: monospace; font-size: 0.82rem;">
                  {restaurant._meta.missingFields.map((path) => (
                    <li style="color: #ffd086;">{path}</li>
                  ))}
                </ul>
              </section>
            )}

            <section class="admin-panel">
              <details>
                <summary class="admin-json-summary">JSON crudo</summary>
                <pre class="admin-panel__json" style="margin-top: 1rem;">{JSON.stringify(restaurant, null, 2)}</pre>
              </details>
            </section>
          </aside>
        </div>
      </>
    )}
  </main>

  <script>
    const forms = document.querySelectorAll<HTMLFormElement>('form[data-pending]');
    for (const form of Array.from(forms)) {
      form.addEventListener('submit', (e) => {
        const confirmMsg = form.dataset.confirm;
        if (confirmMsg && !window.confirm(confirmMsg)) {
          e.preventDefault();
          return;
        }
        const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
        if (btn) {
          btn.disabled = true;
          btn.setAttribute('aria-disabled', 'true');
          const span = btn.querySelector('span:last-child');
          if (span) span.innerHTML = '<span class="admin-spinner" aria-hidden="true"></span> Procesando…';
        }
      });
    }
  </script>
</BaseLayout>
